rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function for documents that need to be created with the user's ID
    function userIdIsValid() {
      return request.resource.data.userId == request.auth.uid;
    }
    
    // Helper function to ensure userId cannot be modified on update
    function userIdNotModified() {
      return request.resource.data.userId == resource.data.userId;
    }
    
    // Helper to check if all required fields are present for a document
    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && 
                    hasRequiredFields(['email', 'displayName', 'role', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId);
      allow delete: if false; // Prevents user deletion (add admin role check if needed)
    }
    
    // Projects collection
    match /projects/{projectId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() && 
                    hasRequiredFields(['name', 'status', 'startDate', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Owner-scoped dashboard read model. The client can refresh its own summary
    // document, but it cannot create or mutate another user's aggregate data.
    match /dashboard_summaries/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && userIdIsValid();
      allow update: if isOwner(userId) && userIdNotModified();
      allow delete: if isOwner(userId);
    }
    
    // Expenses collection
    match /expenses/{expenseId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() && 
                    hasRequiredFields(['projectId', 'category', 'amount', 'date', 'status', 'createdBy']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Expense transactions collection
    match /expense_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'expenseId', 'amount', 'transactionDate', 'status']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Accounting commitments created when bids are accepted
    match /commitments/{commitmentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'sourceBidId', 'status', 'contractAmount', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Vendor invoices tied to commitments
    match /vendor_invoices/{invoiceId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'commitmentId', 'description', 'invoiceDate', 'amount', 'status', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Vendor payments tied to vendor invoices
    match /vendor_payments/{paymentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'commitmentId', 'vendorInvoiceId', 'amount', 'paymentDate', 'status', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Owner/client invoices
    match /owner_invoices/{invoiceId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'description', 'invoiceDate', 'amount', 'status', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Owner/client payments
    match /owner_payments/{paymentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'ownerInvoiceId', 'amount', 'paymentDate', 'status', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Lien waiver tracking for commitment closeout
    match /lien_waivers/{waiverId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'commitmentId', 'status', 'requiredForCloseout', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Subcontractors collection
    match /subcontractors/{subcontractorId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() && 
                    hasRequiredFields(['name', 'specialty', 'contact', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Bids collection
    match /bids/{bidId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() && 
                    hasRequiredFields(['projectId', 'status', 'totalAmount', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() && 
                    hasRequiredFields(['projectId', 'title', 'status', 'priority', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Documents collection
    match /documents/{documentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    hasRequiredFields(['projectId', 'name', 'type', 'url', 'uploadedBy', 'createdAt', 'updatedAt']);
      allow update: if isOwner(resource.data.userId) && userIdNotModified();
      allow delete: if isOwner(resource.data.userId);
    }

    // Shared reports are bearer-token style links. The shareId is the document id
    // so public viewers can use direct gets while rules still enforce expiration.
    match /shared_reports/{shareId} {
      function sharedReportIsUnexpired() {
        return request.time < resource.data.expiresAt;
      }

      allow get: if sharedReportIsUnexpired() || isOwner(resource.data.userId);
      allow list: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && userIdIsValid() &&
                    request.resource.data.shareId == shareId &&
                    hasRequiredFields([
                      'projectId',
                      'projectName',
                      'userId',
                      'createdAt',
                      'expiresAt',
                      'reportType',
                      'shareId',
                      'accessCount',
                      'isPasswordProtected',
                      'reportSnapshot'
                    ]);
      allow update: if (
                      isOwner(resource.data.userId) && userIdNotModified()
                    ) || (
                      sharedReportIsUnexpired() &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCount', 'lastAccessedAt']) &&
                      request.resource.data.accessCount == resource.data.accessCount + 1 &&
                      request.resource.data.lastAccessedAt == request.time
                    );
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Default rules - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 
