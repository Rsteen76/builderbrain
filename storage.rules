rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isProjectOwner(projectId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/projects/$(projectId)) &&
        firestore.get(/databases/(default)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    function isBidOwner(bidId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/bids/$(bidId)) &&
        firestore.get(/databases/(default)/documents/bids/$(bidId)).data.userId == request.auth.uid;
    }

    function isAllowedDocumentUpload(fileName) {
      return request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$') &&
        fileName.matches('.*\\.(pdf|jpg|jpeg|png|webp)$');
    }

    function isAllowedImageUpload(fileName) {
      return request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('^(image/jpeg|image/png|image/webp)$') &&
        fileName.matches('.*\\.(jpg|jpeg|png|webp)$');
    }

    match /projects/{projectId}/{folder}/{fileName} {
      allow read, delete: if folder in ['documents', 'photos'] && isProjectOwner(projectId);
      allow create, update: if isProjectOwner(projectId) &&
        ((folder == 'documents' && isAllowedDocumentUpload(fileName)) ||
         (folder == 'photos' && isAllowedImageUpload(fileName)));
    }

    match /users/{userId}/avatar.jpg {
      allow read, delete: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId && isAllowedImageUpload('avatar.jpg');
    }

    match /bids/{bidId}/attachments/{fileName} {
      allow read, delete: if isBidOwner(bidId);
      allow create, update: if isBidOwner(bidId) && isAllowedDocumentUpload(fileName);
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
